{
  "name": "dtd2mysql",
  "version": "6.6.14",
  "description": "Command line tool to put the GB rail DTD feed into a MySQL compatible database",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "files": [
    "dist/src",
    "dist/config"
  ],
  "bin": "bin/dtd2mysql.sh",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "watch-test": "vitest",
    "start": "tsx ./src/index.ts",
    "prepublishOnly": "tsc -b",
    "gtfs": "tsx ./src/index.ts --gtfs",
    "gtfs-zip": "tsx ./src/index.ts --gtfs-zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/dtd2mysql.git"
  },
  "keywords": [
    "gb",
    "rail",
    "etl",
    "fares",
    "routeing",
    "timetable",
    "dtd"
  ],
  "author": "Linus Norton",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/dtd2mysql/issues"
  },
  "homepage": "https://github.com/planarnetwork/dtd2mysql#readme",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@gb-rail/dtd-schema": "workspace:^",
    "@gb-rail/feed-parser": "workspace:^",
    "adm-zip": "0.6.0",
    "byline": "5.0.0",
    "csv-write-stream": "2.0.0",
    "memoized-class-decorator": "1.6.1",
    "mysql2": "3.23.0",
    "proj4": "2.20.9",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/byline": "4.2.36",
    "@types/csv-write-stream": "2.0.3",
    "@types/node": "26.1.1",
    "@types/ssh2": "1.15.5",
    "chai": "6.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "esbuild@0.28.2": {
      "built": true
    },
    "ssh2@1.17.0": {
      "built": true
    }
  }
}
