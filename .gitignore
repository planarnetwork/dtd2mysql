node_modules/
.idea/
typings/
npm-debug.log
dist/
*.txt
# the committed golden feeds, which is the point of them being text
!apps/*/fixtures/**/*.txt
*.d.ts
*.tsbuildinfo

# Yarn 4 (Berry). The release bundle is committed so every checkout, including
# CI, runs the same yarn; everything else it writes is generated.
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
.pnp.*

# local e2e baseline work (feeds, snapshots, credentials)
.env
.env.local
# The feeds are large, current and perishable, and the GTFS snapshot keeps the
# payload it fingerprinted. The scripts and the table fingerprints are the
# reproducible part, so those are tracked - see data/README.md.
data/feeds/
data/snapshots/gtfs-*/
data/snapshots/db-mini/
data/*.log
data/*.pid
data/probe*

# Tarballs written by the release, one per workspace, and removed as soon as
# npm has taken them.
*.tgz

# Astro's generated types, per workspace. `dist/` above covers the built site.
.astro/

# The feed, mirrored into the site by the Pages workflow. `public/` itself is
# tracked - it holds the redirect that keeps the pre-redesign URL working.
apps/website/public/gtfs.zip

# The patterns, mirrored into the site by the same workflow and broken up a
# station at a time beside themselves: 2,797 files and 163MB, rebuilt from the
# release every time the site is.
apps/website/public/transfer-patterns.br
apps/website/public/transfer-patterns/

# Downloaded by the validate job and by hand; 40MB and versioned by the workflow.
gtfs-validator.jar
