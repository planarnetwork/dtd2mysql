---
import Base from "../../layouts/Base.astro";
import {latest, built, date, number} from "../../feed.js";
import {assets} from "../../explorer/mirrored.js";
import {RELEASE} from "../../site.js";
import "../../styles/explorer.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = await latest();
const mirrored = assets();
---
<Base
  app
  title="Feed explorer"
  description="Open the latest GB rail GTFS feed in your browser, or one of your own, and look inside it: every file, every row, every station and every train, with the checks and the enrichment ledger that say why it holds what it holds."
>
  <div id="explorer" class="app" data-base={base}>

    {/* Everything the build actually left beside the site, so the page never asks for a 404. */}
    <script id="explorer-assets" type="application/json" set:html={JSON.stringify(mirrored)} />

    {/*
      Before a feed is open. This is the only part of the page that reads like the rest of the site,
      and it is gone the moment there is something to work on.
    */}
    <section id="explorer-open" class="landing">
      <div class="landing__box">
        <h1 class="landing__title">Feed explorer</h1>
        <p class="landing__lede">
          Open the feed and look inside it. Every file and every row, the stations and the trains
          they belong to, the days a service runs and the reason it does not run on the others
          &mdash; and where the feed's own build says each value came from.
        </p>

        <div class="landing__ways">
          {mirrored.feed === undefined
            ? <div>
                <p class="landing__none">
                  The latest feed is not published beside this page. That is normal in a checkout
                  &mdash; the nightly build puts it here, not the repository.
                </p>
                <a class="btn btn--signal" href={`${RELEASE}/gtfs.zip`}>Download gtfs.zip &rarr;</a>
              </div>
            : <div>
                <button class="btn btn--signal" data-open-latest type="button">
                  Open the latest feed &rarr;
                </button>
                <p class="note">
                  {Math.round(mirrored.feed.bytes / 1024 / 1024)} MB, served from this site.
                  {meta === undefined ? null : ` Built ${built(meta)} from ${meta.feed_version},
                    covering ${date(meta.feed_start_date)} to ${date(meta.feed_end_date)}
                    with ${number(meta.trips)} trips.`}
                </p>
              </div>}

          <div>
            <label class="landing__file">
              <span>or open a feed of your own</span>
              <input type="file" accept=".zip,application/zip" data-file />
            </label>
            <p class="note">
              Any GTFS zip. Drop it anywhere on this page. It is read in your browser and goes
              nowhere.
            </p>
          </div>
        </div>

        <p class="note landing__foot">
          This is the one page here that runs JavaScript, and the only place it may ask anything of
          anyone else &mdash; the map on a station is a button, and it says so.
        </p>

        <noscript>
          <p class="warn">
            The explorer reads the feed in your browser, so it needs JavaScript. There is no server
            here to read it for you, which is the point: a 21 MB zip stays on your machine.
          </p>
          <pre><code>{`curl -LO ${RELEASE}/gtfs.zip
unzip -o gtfs.zip
grep '^910GCLPHMJC,' stops.txt`}</code></pre>
        </noscript>
      </div>
    </section>

    {/*
      Opening one. A feed is 202 MB of text, most of it stop_times.txt, so this is a real wait and
      it says what it is doing rather than spinning.
    */}
    <section id="explorer-loading" class="loading" hidden>
      <div class="loading__box">
        <p class="loading__what" id="explorer-loading-what">Opening the feed…</p>
        <div class="loading__track" role="progressbar" aria-labelledby="explorer-loading-what"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="loading__bar" id="explorer-loading-bar"></div>
        </div>
        <p class="loading__detail" id="explorer-loading-detail"></p>
      </div>
    </section>

    {/* The app. Hidden until a feed is open, then it is the whole viewport. */}
    <div id="explorer-app" class="app__shell" hidden>
      <header class="bar">
        <span class="bar__feed" id="explorer-name"></span>
        <span class="bar__calls" id="explorer-calls"></span>
        <nav class="bar__nav" id="explorer-nav" aria-label="Explorer">
          <a href="#/" data-view="overview">Overview</a>
          <a href="#/checks" data-view="checks">Checks</a>
          {/* Shown once the sidecar behind each has arrived, so neither is a link to an empty page. */}
          <a href="#/validation" data-view="validation" hidden>Validation</a>
          <a href="#/provenance" data-view="provenance" hidden>Provenance</a>
        </nav>
        <button id="explorer-close" class="bar__close" type="button" title="Close this feed">
          Close
        </button>
      </header>

      <div class="app__body">
        <nav class="rail" id="explorer-rail" aria-label="Files"></nav>
        <div class="pane" id="explorer-view"></div>
      </div>

      <p class="status status--note" id="explorer-note" role="status" aria-live="polite" hidden></p>
    </div>
  </div>
</Base>

<script>
  import {boot} from "../../explorer/ui/boot.js";

  boot();
</script>
