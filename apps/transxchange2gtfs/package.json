{
  "name": "transxchange2gtfs",
  "version": "1.12.0",
  "description": "Convert TransXChange data to GTFS",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": "bin/transxchange2gtfs.sh",
  "scripts": {
    "build": "tsc -b",
    "start": "yarn build && tsx ./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/dtd2mysql.git",
    "directory": "apps/transxchange2gtfs"
  },
  "keywords": [
    "gb",
    "bus",
    "gtfs",
    "timetable",
    "transxchange",
    "naptan"
  ],
  "author": "Linus Norton",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/dtd2mysql/issues"
  },
  "homepage": "https://github.com/planarnetwork/dtd2mysql#readme",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@gb-transit/gtfs": "workspace:^",
    "@gb-transit/gtfs-output": "workspace:^",
    "@gb-transit/gtfs-schema": "workspace:^",
    "@gb-transit/naptan": "workspace:^",
    "@gb-transit/txc-source": "workspace:^",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.14",
    "typescript": "7.0.2"
  }
}
