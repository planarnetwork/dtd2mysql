{
  "compilerOptions": {
    "types": ["node", "mocha"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    /* todo: update once ts bump */
    "target": "esnext",
    "sourceMap": true,
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "exclude": [
    "node_modules",
    "dist/"
  ]
}
