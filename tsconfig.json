{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "es2017",
    "sourceMap": true,
    "experimentalDecorators": true,
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "esnext"
    ],
    "types": [
      "node",
      "mocha"
    ]
  },
  "exclude": [
    "node_modules",
    "dist/"
  ]
}
